# .env.example（提交到 Git）

# OpenAI API Key（必填）
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=

# Anthropic API Key（可选）
# 从 https://console.anthropic.com/settings/keys 获取
ANTHROPIC_API_KEY=

# LangSmith 配置（推荐）
# 从 https://smith.langchain.com 获取
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=my-first-agent
